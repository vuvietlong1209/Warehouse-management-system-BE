# ============================================================
# BACKEND ENVIRONMENT CONFIGURATION
# Sao chép file này thành .env và điền thông tin kết nối
# ============================================================

# --- Cổng API Server ---
PORT=4000

# --- Xác thực (ít nhất 32 ký tự, thay bằng chuỗi ngẫu nhiên riêng khi triển khai) ---
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-characters

# --- SQL Server Connection ---
# Nếu dùng Windows Authentication (Trusted_Connection):
#   DB_USER và DB_PASSWORD để trống, DB_TRUSTED_CONNECTION=true
# Nếu dùng SQL Server Authentication:
#   Điền DB_USER và DB_PASSWORD, DB_TRUSTED_CONNECTION=false

DB_SERVER=localhost
# Nếu dùng SQL Express: DB_SERVER=localhost\SQLEXPRESS
DB_NAME=EWarehouseDB
DB_USER=sa
DB_PASSWORD=YourPasswordHere
DB_TRUSTED_CONNECTION=false
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true
DB_PORT=1433

# --- Frontend and business date ---
FRONTEND_URL=http://localhost:3000
APP_TIMEZONE=Asia/Ho_Chi_Minh

# --- Cross-repository tests only ---
# Relative paths are resolved from this backend repository, not its parent.
# Clone the frontend next to this folder as Frontend_push, or change this path.
FRONTEND_ROOT=../Frontend_push

# --- PDF fonts on machines without Windows Times New Roman ---
# Use fonts you are licensed to use; do not commit proprietary font files.
# REPORT_FONT_REGULAR=/absolute/path/to/times.ttf
# REPORT_FONT_BOLD=/absolute/path/to/timesbd.ttf
# REPORT_FONT_ITALIC=/absolute/path/to/timesi.ttf
